<?xml version="1.0"?>
<robot name="simple_arm">
<!-- Sensowny model ramienia -->
    <!-- BAZA: 200 x 200 x 20 mm -->
    <link name="baza">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.2 0.2 0.02"/>
            </geometry>
            <material name="green">
                <color rgba="0.23 0.875 0.23 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.2 0.2 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="5"/>
            <inertia ixx="0.0167" ixy="0" ixz="0"
                     iyy="0.0167" iyz="0" izz="0.0333"/>
        </inertial>
    </link>

    <!-- CYLINDER 0: PRZEGUB OBROTOWY PODSTAWY -->
    <!-- Cylinder ustawiony pionowo, długość 40 mm -->
    <link name="cylinder_base">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.04"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.23 0.875 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.3"/>
            <inertia ixx="0.0001" ixy="0" ixz="0"
                     iyy="0.0001" iyz="0" izz="0.000094"/>
        </inertial>
    </link>

    <!-- SFERA 1: PRZEGUB BARKOWY -->
    <link name="sfera1">
        <visual>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <material name="red">
                <color rgba="0.875 0.23 0.23 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.00005" ixy="0" ixz="0"
                     iyy="0.00005" iyz="0" izz="0.00005"/>
        </inertial>
    </link>

    <!-- WALEC 1: RAMIĘ 300 mm -->
    <link name="walec1">
        <visual>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <cylinder radius="0.015" length="0.3"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.23 0.875 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <cylinder radius="0.015" length="0.3"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.15"/>
            <mass value="0.5"/>
            <inertia ixx="0.00377" ixy="0" ixz="0"
                     iyy="0.00377" iyz="0" izz="0.0000563"/>
        </inertial>
    </link>

    <!-- SFERA 2: PRZEGUB ŁOKCIOWY -->
    <link name="sfera2">
        <visual>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <material name="red">
                <color rgba="0.875 0.23 0.23 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.00005" ixy="0" ixz="0"
                     iyy="0.00005" iyz="0" izz="0.00005"/>
        </inertial>
    </link>

    <!-- WALEC 2: RAMIĘ 200 mm -->
    <link name="walec2">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.015" length="0.2"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.23 0.875 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.015" length="0.2"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.1"/>
            <mass value="0.35"/>
            <inertia ixx="0.00118" ixy="0" ixz="0"
                     iyy="0.00118" iyz="0" izz="0.0000394"/>
        </inertial>
    </link>

    <!-- SFERA 3: KONIEC RAMIENIA -->
    <link name="sfera3">
        <visual>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <material name="red">
                <color rgba="0.875 0.23 0.23 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.00005" ixy="0" ixz="0"
                     iyy="0.00005" iyz="0" izz="0.00005"/>
        </inertial>
    </link>

    <!-- WALEC 3: MOCOWANIE EFEKTORA, 40 mm -->
    <link name="walec3">
        <visual>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <cylinder radius="0.012" length="0.04"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.23 0.875 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <cylinder radius="0.012" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.02"/>
            <mass value="0.1"/>
            <inertia ixx="0.0000141" ixy="0" ixz="0"
                     iyy="0.0000141" iyz="0" izz="0.0000072"/>
        </inertial>
    </link>

    <!-- POŁĄCZENIA -->

    <!-- Baza -> cylinder -->
    <joint name="baza_cylinder" type="fixed">
        <parent link="baza"/>
        <child link="cylinder_base"/>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </joint>

    <!-- Cylinder -> sfera 1: obrót wokół osi Z -->
    <joint name="cylinder_sfera1" type="revolute">
        <parent link="cylinder_base"/>
        <child link="sfera1"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.4" upper="1.4"
               effort="30" velocity="1.0"/>
    </joint>

    <!-- Bark: obrót wokół osi Y -->
    <joint name="sfera1_walec1" type="revolute">
        <parent link="sfera1"/>
        <child link="walec1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.4" upper="1.4"
               effort="30" velocity="1.0"/>
    </joint>

    <!-- Koniec pierwszego ramienia: 300 mm -->
    <joint name="walec1_sfera2" type="fixed">
        <parent link="walec1"/>
        <child link="sfera2"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
    </joint>

    <!-- Łokieć: obrót wokół osi Y -->
    <joint name="sfera2_walec2" type="revolute">
        <parent link="sfera2"/>
        <child link="walec2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0944" upper="0"
               effort="20" velocity="1.0"/>
    </joint>

    <!-- Koniec drugiego ramienia: 200 mm -->
    <joint name="walec2_sfera3" type="fixed">
        <parent link="walec2"/>
        <child link="sfera3"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </joint>

    <!-- Mocowanie efektora -->
    <joint name="sfera3_walec3" type="fixed">
        <parent link="sfera3"/>
        <child link="walec3"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>